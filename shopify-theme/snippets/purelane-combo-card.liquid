{%- liquid
  assign combo_title = combo.title.value
  assign combo_description = combo.short_description.value
  assign combo_badge = combo.badge.value
  assign combo_savings_label = combo.savings_label.value
  assign combo_product = combo.combo_product.value
  assign combo_products = combo.included_products.value
  assign combo_highlighted = combo.highlighted.value
  assign combo_price = combo_product.price
  assign combo_compare_at = combo_product.compare_at_price
-%}

<article class="purelane-combo-card{% if combo_highlighted %} purelane-combo-card--highlighted{% endif %}">
  <div class="purelane-combo-card__tray">
    {%- if combo_savings_label != blank -%}
      <span class="purelane-combo-card__savings-label">{{ combo_savings_label | escape }}</span>
    {%- endif -%}

    {%- if combo_badge != blank -%}
      <span class="purelane-combo-card__badge">{{ combo_badge | escape }}</span>
    {%- endif -%}

    <div class="purelane-combo-card__products" aria-label="{{ combo_title | escape }} includes">
      {%- for included_product in combo_products limit: 5 -%}
        <div class="purelane-combo-card__product">
          <span class="purelane-combo-card__product-media">
            {%- if included_product.featured_image -%}
              <img
                src="{{ included_product.featured_image | image_url: width: 180 }}"
                width="90"
                height="90"
                loading="lazy"
                alt="{{ included_product.featured_image.alt | default: included_product.title | escape }}"
              >
            {%- else -%}
              <span class="purelane-combo-card__product-placeholder" aria-hidden="true">+</span>
            {%- endif -%}
          </span>
          <span class="purelane-combo-card__product-name">{{ included_product.title | truncate: 28 | escape }}</span>
        </div>
        {%- unless forloop.last -%}
          <span class="purelane-combo-card__plus" aria-hidden="true">+</span>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="purelane-combo-card__body">
    <h3 class="purelane-combo-card__title">{{ combo_title | escape }}</h3>
    <p class="purelane-combo-card__count">{{ combo_products.size }} products</p>

    {%- if combo_description != blank -%}
      <p class="purelane-combo-card__description">{{ combo_description | escape }}</p>
    {%- endif -%}

    <div class="purelane-combo-card__price">
      <strong>{{ combo_price | money }}</strong>
      {%- if combo_compare_at > combo_price -%}
        <s>{{ combo_compare_at | money }}</s>
        <em>
          {{ combo_compare_at | minus: combo_price | money_without_trailing_zeros }} saved
        </em>
      {%- endif -%}
    </div>

    <p class="purelane-combo-card__fine-print">Inclusive of all taxes · COD available</p>

    {%- if combo_product.available -%}
      <form method="post" action="{{ routes.cart_add_url }}">
        <input type="hidden" name="id" value="{{ combo_product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="purelane-button purelane-button--secondary" type="submit">
          Shop bundle <span aria-hidden="true">→</span>
        </button>
      </form>
    {%- else -%}
      <button class="purelane-button purelane-button--disabled" type="button" disabled>
        Sold out
      </button>
    {%- endif -%}
  </div>
</article>
