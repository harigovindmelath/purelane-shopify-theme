{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

{%- assign combo_entries = section.settings.combos -%}

<section
  id="PurelaneCombos-{{ section.id }}"
  class="purelane-combos"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="PurelaneCombosHeading-{{ section.id }}"{% else %}aria-label="Purelane combos"{% endif %}
>
  <div class="purelane-shell">
    <header class="purelane-section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="purelane-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="PurelaneCombosHeading-{{ section.id }}" class="purelane-display">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="purelane-rule" aria-hidden="true">
        <span></span>
        <span class="purelane-rule__mark"></span>
        <span></span>
      </div>

      {%- if section.settings.description != blank -%}
        <p class="purelane-lede">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </header>

    {%- if combo_entries != blank and combo_entries.size > 0 -%}
      <div class="purelane-combo-rail" tabindex="0" aria-label="Purelane combos">
        {%- for combo in combo_entries -%}
          {%- if combo.combo_product.value != blank and combo.included_products.value != blank -%}
            {% render 'purelane-combo-card', combo: combo %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="purelane-combo-swipe-hint" aria-hidden="true">
        <span>→</span> Swipe for more combos
      </p>
    {%- else -%}
      <div class="purelane-empty-state">
        <p>Create and select Purelane combo metaobjects in the theme editor to populate this section.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is priced below buying the same products on their own."
    },
    {
      "type": "metaobject_list",
      "id": "combos",
      "label": "Combo entries",
      "metaobject_type": "purelane_combo",
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "Purelane combos"
    }
  ]
}
{% endschema %}
