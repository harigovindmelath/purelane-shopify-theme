{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

<section id="PurelaneBundles-{{ section.id }}" class="purelane-bundles" {% if section.settings.heading != blank %}aria-labelledby="PurelaneBundlesHeading-{{ section.id }}"{% endif %}>
  <div class="purelane-shell">
    <header class="purelane-section-heading">
      {% if section.settings.eyebrow != blank %}<p class="purelane-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="PurelaneBundlesHeading-{{ section.id }}" class="purelane-display">{{ section.settings.heading | escape }}</h2>{% endif %}
      <div class="purelane-rule" aria-hidden="true"><span></span><span class="purelane-rule__mark"></span><span></span></div>
      {% if section.settings.description != blank %}<p class="purelane-lede">{{ section.settings.description | escape }}</p>{% endif %}
    </header>

    {% if section.settings.combos != blank %}
      <div class="purelane-bundle-grid">
        {% for combo in section.settings.combos limit: 3 %}
          {% assign combo_product = combo.combo_product.value %}
          {% assign included_products = combo.included_products.value %}
          {% if combo_product != blank %}
            <article class="purelane-bundle-card {% if combo.highlighted.value %}purelane-bundle-card--featured{% endif %}">
              <div class="purelane-bundle-card__top">
                {% if combo.badge.value != blank %}<span class="purelane-bundle-card__badge">{{ combo.badge.value | escape }}</span>{% endif %}
                <div class="purelane-bundle-card__media">
                  {% if combo_product.featured_image %}
                    {% assign bundle_image_alt = combo_product.featured_image.alt | default: combo_product.title %}
                    {{ combo_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 860px) 33vw, 100vw', alt: bundle_image_alt }}
                  {% else %}
                    <span class="purelane-bundle-card__product-placeholder">✦</span>
                  {% endif %}
                </div>
              </div>
              <div class="purelane-bundle-card__body">
                <p class="purelane-bundle-card__count">{{ included_products.size }} products</p>
                <h3>{{ combo.title.value | default: combo_product.title | escape }}</h3>
                {% if combo.short_description.value != blank %}<p class="purelane-bundle-card__description">{{ combo.short_description.value | escape }}</p>{% endif %}
                <div class="purelane-bundle-card__price">
                  <strong>{{ combo_product.price | money }}</strong>
                  {% if combo_product.compare_at_price > combo_product.price %}<s>{{ combo_product.compare_at_price | money }}</s>{% endif %}
                </div>
                {% if combo.savings_label.value != blank %}<p class="purelane-bundle-card__saving">{{ combo.savings_label.value | escape }}</p>{% endif %}
                <p class="purelane-bundle-card__fine-print">Inclusive of all taxes · COD available</p>
                <a class="purelane-button {% if combo.highlighted.value %}purelane-button--primary{% else %}purelane-button--secondary{% endif %}" href="{{ combo_product.url }}">Shop this box</a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="purelane-empty-state"><p>Select up to three Purelane combo entries in the theme editor to populate this section.</p></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle and save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better together" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Thoughtfully paired essentials for every kind of clean." },
    { "type": "metaobject_list", "id": "combos", "label": "Combo entries", "metaobject_type": "purelane_combo", "limit": 3 }
  ],
  "presets": [{ "name": "Purelane bundles" }]
}
{% endschema %}