{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
{{ 'purelane-reviews.css' | asset_url | stylesheet_tag }}

<section id="PurelaneReviews-{{ section.id }}" class="purelane-reviews" {% if section.settings.heading != blank %}aria-labelledby="PurelaneReviewsHeading-{{ section.id }}"{% endif %}>
  <div class="purelane-shell">
    <header class="purelane-reviews__heading">
      {% if section.settings.eyebrow != blank %}<p class="purelane-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="PurelaneReviewsHeading-{{ section.id }}" class="purelane-display">{{ section.settings.heading | escape }}</h2>{% endif %}
      <div class="purelane-reviews__stats">
        {% if section.settings.rating_text != blank %}<p><span aria-hidden="true">★★★★★</span> {{ section.settings.rating_text | escape }}</p>{% endif %}
        {% if section.settings.homes_text != blank %}<p>{{ section.settings.homes_text | escape }}</p>{% endif %}
      </div>
    </header>

    {% if section.blocks.size > 0 %}
      <div class="purelane-reviews__rail" tabindex="0" aria-label="Customer reviews">
        {% for block in section.blocks %}
          <article class="purelane-review-card" {{ block.shopify_attributes }}>
            <p class="purelane-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for star in (1..5) %}{% if star <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</p>
            <h3>{{ block.settings.title | escape }}</h3>
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
            <p class="purelane-review-card__who"><span aria-hidden="true">✓</span><strong>{{ block.settings.customer_name | escape }}</strong>{% if block.settings.product_name != blank %}<span>· {{ block.settings.product_name | escape }}</span>{% endif %}</p>
          </article>
        {% endfor %}
      </div>
      <p class="purelane-reviews__hint" aria-hidden="true">← Swipe for more reviews →</p>
    {% else %}
      <div class="purelane-empty-state"><p>Add testimonial blocks in the theme editor to populate this section.</p></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "That's what they said" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved in real homes" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8 from 8,000+ reviews" },
    { "type": "text", "id": "homes_text", "label": "Homes text", "default": "Loved by 12 lakh+ homes" }
  ],
  "blocks": [{
    "type": "review",
    "name": "Review",
    "settings": [
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
      { "type": "textarea", "id": "quote", "label": "Review", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
      { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Anita" },
      { "type": "text", "id": "product_name", "label": "Product", "default": "Laundry detergent" }
    ]
  }],
  "presets": [{ "name": "Purelane reviews", "blocks": [{ "type": "review" }, { "type": "review", "settings": { "title": "Best dishwash ever", "quote": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "customer_name": "Priya", "product_name": "Dishwash gel" } }, { "type": "review", "settings": { "title": "Great product, great packaging", "quote": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "customer_name": "Sunita", "product_name": "Liquid handwash" } }]}]
}
{% endschema %}