{% liquid
  assign hero_background = section.settings.background_image
  assign promise_blocks = section.blocks | where: 'type', 'promise'
  assign slide_blocks = section.blocks | where: 'type', 'slide'
%}
{{ 'purelane-sections.css' | asset_url | stylesheet_tag }}
{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

<section id="PurelaneHero-{{ section.id }}" class="purelane-hero" data-section-id="{{ section.id }}" {% if hero_background != blank %}style="--purelane-hero-image: url('{{ hero_background | image_url: width: 2400 }}');"{% endif %}>
  <div class="purelane-hero__proof-bar" aria-label="Purelane offers">
    <div class="purelane-hero__proof-track">
      <span>★ Loved by 30,000+ homes</span>
      <span>✦ Buy any 3 at a flat ₹499</span>
      <span>✓ Plant-powered and family-safe</span>
      <span aria-hidden="true">★ Loved by 30,000+ homes</span>
      <span aria-hidden="true">✦ Buy any 3 at a flat ₹499</span>
      <span aria-hidden="true">✓ Plant-powered and family-safe</span>
    </div>
  </div>
  <div class="purelane-hero__shell">
    <div class="purelane-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="purelane-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 id="PurelaneHeroHeading-{{ section.id }}" class="purelane-hero__heading">{{ section.settings.heading | escape | newline_to_br }}{% if section.settings.accent_heading != blank %}<br><span>{{ section.settings.accent_heading | escape }}</span>{% endif %}</h1>
      <div class="purelane-rule" aria-hidden="true"><span></span><span class="purelane-rule__mark"></span><span></span></div>
      {% if section.settings.description != blank %}<p class="purelane-hero__description">{{ section.settings.description | escape }}</p>{% endif %}
      <div class="purelane-hero__actions">
        {% if section.settings.primary_label != blank %}<a class="purelane-button purelane-button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="purelane-button purelane-button--secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
      </div>
      <div class="purelane-hero__mobile-promises" aria-label="Product promises">{% for block in promise_blocks limit: 3 %}<div class="purelane-hero__promise" {{ block.shopify_attributes }}><span class="purelane-hero__promise-icon" aria-hidden="true">✦</span><span>{{ block.settings.label | escape }}</span></div>{% endfor %}</div>
    </div>

    <div class="purelane-hero__visual">
      {% if section.settings.enable_featured_stage and slide_blocks.size > 0 %}
        <div class="purelane-hero-stage" data-purelane-hero-stage aria-roledescription="carousel" aria-label="Featured Purelane offers">
          <div class="purelane-hero-stage__slides">
            {% for block in slide_blocks %}
              {% liquid
                assign products = ''
                assign price = 0
                assign compare_price = 0
                for number in (1..3)
                  assign product_key = 'product_' | append: number
                  assign slide_product = block.settings[product_key]
                  if slide_product != blank
                    assign price = price | plus: slide_product.price
                    assign product_compare = slide_product.compare_at_price | default: slide_product.price
                    assign compare_price = compare_price | plus: product_compare
                  endif
                endfor
                assign target = block.settings.link | default: block.settings.product_1.url
              %}
              <a class="purelane-hero-stage__slide{% if forloop.first %} is-active{% endif %}" href="{{ target }}" data-purelane-hero-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
                <span class="purelane-hero-stage__products purelane-hero-stage__products--{{ forloop.index }}">
                  {% for number in (1..3) %}{% assign product_key = 'product_' | append: number %}{% assign slide_product = block.settings[product_key] %}{% if slide_product != blank %}<span class="purelane-hero-stage__product purelane-hero-stage__product--{{ forloop.index }}-{{ number }}">{% if slide_product.featured_image %}{{ slide_product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '420, 640, 900', sizes: '(min-width: 901px) 43vw, 90vw', alt: slide_product.title }}{% else %}<span class="purelane-hero__product-placeholder" aria-hidden="true"></span>{% endif %}</span>{% endif %}{% endfor %}
                </span>
                <span class="purelane-hero__offer"><span class="purelane-hero__offer-label">{{ block.settings.label | default: 'Featured offer' | escape }}</span><span class="purelane-hero__offer-price"><strong>{{ price | money }}</strong>{% if compare_price > price %}<s>{{ compare_price | money }}</s>{% endif %}</span>{% if block.settings.note != blank %}<span class="purelane-hero__offer-note">{{ block.settings.note | escape }}</span>{% endif %}</span>
              </a>
            {% endfor %}
          </div>
          {% if slide_blocks.size > 1 %}<div class="purelane-hero-stage__dots" aria-label="Choose featured offer">{% for block in slide_blocks %}<button type="button" class="{% if forloop.first %}is-active{% endif %}" data-purelane-hero-dot aria-label="Show offer {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div>{% endif %}
        </div>
      {% else %}
        <div class="purelane-hero__ambient" aria-hidden="true">
          <span class="purelane-hero__ambient-wave purelane-hero__ambient-wave--one"></span>
          <span class="purelane-hero__ambient-wave purelane-hero__ambient-wave--two"></span>
          <span class="purelane-hero__ambient-orb purelane-hero__ambient-orb--one"></span>
          <span class="purelane-hero__ambient-orb purelane-hero__ambient-orb--two"></span>
          <span class="purelane-hero__ambient-ripple"></span>
          <span class="purelane-hero__ambient-spark purelane-hero__ambient-spark--one">✦</span>
          <span class="purelane-hero__ambient-spark purelane-hero__ambient-spark--two">✦</span>
          <div class="purelane-hero__ambient-core"><span class="purelane-hero__ambient-core-mark">✦</span><p>Clean home.<br>Clear mind.</p></div>
          <span class="purelane-hero__ambient-note purelane-hero__ambient-note--one"><b>Plant-powered</b><small>tough on grime</small></span>
          <span class="purelane-hero__ambient-note purelane-hero__ambient-note--two"><b>Kind by nature</b><small>safe around family</small></span>
        </div>
      {% endif %}
    </div>

    <aside class="purelane-hero__desktop-promises" aria-label="Product promises">{% for block in promise_blocks limit: 3 %}<div class="purelane-hero__desktop-promise" {{ block.shopify_attributes }}><span class="purelane-hero__promise-icon" aria-hidden="true">✦</span><span>{{ block.settings.label | escape }}</span></div>{% endfor %}</aside>
  </div>
</section>

{% schema %}
{
  "name":"Purelane hero","tag":"section","class":"section","max_blocks":9,
  "settings":[
    {"type":"image_picker","id":"background_image","label":"Background image"},\n    {"type":"checkbox","id":"enable_featured_stage","label":"Enable featured-product stage","default":false,"info":"Leave off to use the animated ambient Hero artwork instead."},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Plant-powered homecare"},
    {"type":"textarea","id":"heading","label":"Heading","default":"Clean\nThat"},
    {"type":"text","id":"accent_heading","label":"Accent heading","default":"Lasts"},
    {"type":"textarea","id":"description","label":"Description","default":"Homecare that works on the toughest grime, made from plants. Kind to your home, your family, and the world outside it."},
    {"type":"text","id":"primary_label","label":"Primary button label","default":"Shop now"},{"type":"url","id":"primary_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"How it works"},{"type":"url","id":"secondary_link","label":"Secondary button link"}
  ],
  "blocks":[
    {"type":"slide","name":"Featured offer","settings":[
      {"type":"text","id":"label","label":"Offer label","default":"Featured offer"},
      {"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2 (optional)"},{"type":"product","id":"product_3","label":"Product 3 (optional)"},
      {"type":"url","id":"link","label":"Click destination (optional)"},{"type":"text","id":"note","label":"Offer note","default":"Tap to shop"}
    ]},
    {"type":"promise","name":"Promise","settings":[{"type":"text","id":"label","label":"Label","default":"Plant powered"}]}
  ],
  "presets":[{"name":"Purelane hero","blocks":[{"type":"promise","settings":{"label":"Plant powered"}},{"type":"promise","settings":{"label":"Safe for kids & pets"}},{"type":"promise","settings":{"label":"Zero harsh chemicals"}}]}]
}
{% endschema %}